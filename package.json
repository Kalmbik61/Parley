{
  "name": "parley",
  "private": true,
  "version": "0.5.1",
  "license": "MIT",
  "author": "Evgeniy",
  "homepage": "https://github.com/Kalmbik61/Parley",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kalmbik61/Parley.git"
  },
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter \"@parley/desktop^...\" build && pnpm --filter @parley/desktop typecheck",
    "dev": "pnpm --filter @parley/host build && pnpm --filter @parley/desktop dev",
    "dev:desktop": "pnpm --filter @parley/host build && pnpm --filter @parley/desktop dev",
    "lint": "eslint packages tools",
    "format": "prettier --write .",
    "postinstall": "node scripts/fix-node-pty-perms.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.0"
  }
}
