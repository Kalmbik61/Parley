{
  "name": "@harnas/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "dist": "pnpm build && rm -rf out/host && pnpm --filter @harnas/host deploy --prod \"$PWD/out/host\" && electron-builder"
  },
  "dependencies": {
    "@harnas/core": "workspace:*",
    "@harnas/host": "workspace:*",
    "@harnas/protocol": "workspace:*",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "dockview-react": "^8.3.1",
    "electron-vite": "^5.0.0",
    "gitdiff-parser": "^0.3.1",
    "react": "^18",
    "react-diff-view": "^3.3.3",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "electron": "44.4.5",
    "electron-builder": "^26.16.1",
    "jsdom": "^30.1.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
